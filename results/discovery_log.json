    "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Drug Interaction Screen</title>\n<meta name=\"description\" content=\"Search, tag, and check FDA prescription drug labels for drug-drug interaction risks. Drug Interaction Screen is free and open access.\">\n<meta name=\"theme-color\" content=\"#151515\">\n<link rel=\"icon\" href=\"/brand/favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"/brand/logo.svg\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/brand/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/brand/favicon-16x16.png\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/brand/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/brand/icon-192.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"512x512\" href=\"/brand/icon-512.png\">\n<meta property=\"og:title\" content=\"Drug Interaction Screen\">\n<meta property=\"og:description\" content=\"Search, tag, and check FDA prescription drug labels for drug-drug interaction risks.\">\n<meta property=\"og:image\" content=\"https://rx-label-search-aidancolvins-projects.vercel.app/brand/og-image.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Drug Interaction Screen\">\n<meta name=\"twitter:description\" content=\"Search, tag, and check FDA prescription drug labels for drug-drug interaction risks.\">\n<meta name=\"twitter:image\" content=\"https://rx-label-search-aidancolvins-projects.vercel.app/brand/og-image.png\">\n<style>\n  body { font-family: -apple-system, system-ui, sans-serif; max-width: 900px; margin: 0 auto; padding: 16px; color: #1a1a1a; }\n  h1 { font-size: 1.4rem; margin-bottom: 4px; }\n  .subtitle { color: #555; font-size: 0.9rem; margin-bottom: 20px; }\n  section { margin-bottom: 28px; }\n  label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.9rem; }\n  input[type=text], textarea { width: 100%; box-sizing: border-box; padding: 8px; font-size: 1rem; border: 1px solid #ccc; border-radius: 6px; }\n  textarea { min-height: 90px; font-family: inherit; }\n  button { margin-top: 8px; padding: 8px 16px; font-size: 0.95rem; border-radius: 6px; border: 1px solid #333; background: #1a1a1a; color: white; cursor: pointer; }\n  button:disabled { opacity: 0.5; cursor: default; }\n  .terms { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }\n  .term-chip { border: 1px solid #999; border-radius: 14px; padding: 3px 10px; font-size: 0.82rem; cursor: pointer; user-select: none; }\n  .term-chip.selected { background: #1a1a1a; color: white; border-color: #1a1a1a; }\n  .op-toggle { font-size: 0.85rem; margin: 6px 0; }\n  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 0.85rem; }\n  th, td { text-align: left; border-bottom: 1px solid #eee; padding: 6px 4px; vertical-align: top; }\n  .hit-tags span, .tag-pill { display: inline-block; background: #eef; border-radius: 8px; padding: 1px 6px; margin: 1px; font-size: 0.75rem; }\n  .alert { border-left: 4px solid #c00; background: #fff4f4; padding: 8px 10px; margin: 8px 0; border-radius: 4px; }\n  .alert.tier-4 { border-left-color: #999; background: #f7f7f7; }\n  .alert.tier-3 { border-left-color: #d90; background: #fff9ef; }\n  .alert.tier-2 { border-left-color: #c40; }\n  .alert.tier-1 { border-left-color: #900; }\n  .alert .member { font-size: 0.85rem; margin-top: 4px; }\n  .notice { font-size: 0.8rem; color: #444; background: #f2f2f2; padding: 10px; border-radius: 6px; margin-top: 16px; }\n  .unresolved { color: #a30; font-size: 0.85rem; }\n  #search-results, #check-results { margin-top: 14px; }\n  a { color: #135; }\n  .brand-lockup { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }\n  .brand-lockup img { width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0; }\n  .brand-lockup h1 { margin: 0; }\n</style>\n</head>\n<body>\n<div class=\"brand-lockup\">\n  <img src=\"/brand/logo.svg\" alt=\"Drug Interaction Screen logo\" width=\"36\" height=\"36\">\n  <h1>Drug Interaction Screen</h1>\n</div>\n<div class=\"subtitle\" id=\"build-date-line\">FDA prescription drug label search, tagging, and interaction checker. Loading build date&hellip;</div>\n\n<section>\n  <h2>Search</h2>\n  <label for=\"search-box\">Keyword search</label>\n  <input type=\"text\" id=\"search-box\" placeholder=\"e.g. muscle spasm\">\n  <div class=\"terms\" id=\"term-filters\"></div>\n  <div class=\"op-toggle\">\n    Combine selected terms with:\n    <label style=\"display:inline\"><input type=\"radio\" name=\"operator\" value=\"AND\" checked> AND</label>\n    <label style=\"display:inline\"><input type=\"radio\" name=\"operator\" value=\"OR\"> OR</label>\n  </div>\n  <button id=\"search-button\">Search</button>\n  <div id=\"search-results\"></div>\n</section>\n\n<section>\n  <h2>Interaction checker</h2>\n  <label for=\"med-box\">Medication list (comma, semicolon, or new-line separated)</label>\n  <textarea id=\"med-box\" placeholder=\"10 mg Zyprexa X 1 daily, 20 mg adderall X 3 daily, ...\"></textarea>\n  <button id=\"check-button\">Check interactions</button>\n  <div id=\"check-results\"></div>\n</section>\n\n<div class=\"notice\" id=\"notice-line\"></div>\n\n<script>\nconst state = { selectedTerms: new Set() };\n\nasync function loadTerms() {\n  const res = await fetch('/api/search?terms_only=1');\n  const data = await res.json();\n  document.getElementById('build-date-line').textContent =\n    'FDA prescription drug label search, tagging, and interaction checker. Build date: ' + data.build_date + '.';\n  const container = document.getElementById('term-filters');\n  container.innerHTML = '';\n  for (const term of data.available_terms) {\n    const chip = document.createElement('span');\n    chip.className = 'term-chip';\n    chip.textContent = term.term_id + ' ' + term.name;\n    chip.dataset.termId = term.term_id;\n    chip.addEventListener('click', () => {\n      if (state.selectedTerms.has(term.term_id)) { state.selectedTerms.delete(term.term_id); chip.classList.remove('selected'); }\n      else { state.selectedTerms.add(term.term_id); chip.classList.add('selected'); }\n    });\n    container.appendChild(chip);\n  }\n}\n\nfunction tierClass(tier) {\n  return tier ? 'tier-' + tier : 'tier-4';\n}\n\nasync function runSearch() {\n  const q = document.getElementById('search-box').value;\n  const operator = document.querySelector('input[name=operator]:checked').value;\n  const params = new URLSearchParams({ q, operator, limit: '20' });\n  for (const term of state.selectedTerms) params.append('term', term);\n  const results = document.getElementById('search-results');\n  results.textContent = 'Searching\u2026';\n  const res = await fetch('/api/search?' + params.toString());\n  const data = await res.json();\n  if (!data.hits || data.hits.length === 0) { results.textContent = 'No results.'; return; }\n  const rows = data.hits.map(hit => `\n    <tr>\n      <td><strong>${hit.brand_name || '(no brand name)'}</strong><br><span style=\"color:#555\">${hit.generic_name || ''}</span></td>\n      <td>${hit.snippet || ''}</td>\n      <td class=\"hit-tags\">${(hit.tags || []).map(t => `<span>${t}</span>`).join('')}</td>\n      <td>${hit.effective_time || ''}</td>\n    </tr>`).join('');\n  results.innerHTML = `<table><thead><tr><th>Drug</th><th>Snippet</th><th>PDLA tags</th><th>Effective</th></tr></thead><tbody>${rows}</tbody></table>`;\n}\n\nasync function runCheck() {\n  const medications = document.getElementById('med-box').value;\n  const results = document.getElementById('check-results');\n  results.textContent = 'Checking\u2026';\n  const res = await fetch('/api/check', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ medications, use_rxnorm: true }) });\n  const data = await res.json();\n  document.getElementById('notice-line').textContent = data.notice || '';\n  let html = '';\n  if (data.medication_table && data.medication_table.length) {\n    const rows = data.medication_table.map(row => `\n      <tr>\n        <td>${row.as_entered}</td>\n        <td>${row.matched_name ? row.matched_name.join(' \u2192 ') : 'Not resolved'}</td>\n        <td>${(row.generic || []).join(', ')}</td>\n        <td>${(row.base_ingredients || []).join(', ')}</td>\n        <td>${(row.brand || []).join(', ')}</td>\n        <td>${row.fda_class}</td>\n        <td>${(row.route || []).join(', ')}</td>\n        <td>${row.dea_schedule || ''}</td>\n        <td>${row.daily_total != null ? row.daily_total + ' ' + (row.daily_total_unit || '') : ''}</td>\n        <td>${(row.pdla_tags || []).map(t => `<span class=\"tag-pill\">${t.term_id}</span>`).join('')}</td>\n      </tr>`).join('');\n    html += `<table><thead><tr><th>As entered</th><th>Matched name</th><th>Generic</th><th>Base ingredients</th><th>Brand</th><th>FDA class</th><th>Route</th><th>DEA schedule</th><th>Daily total</th><th>PDLA tags</th></tr></thead><tbody>${rows}</tbody></table>`;\n  }\n  if (data.alerts && data.alerts.length) {\n    html += '<h3>Alerts</h3>' + data.alerts.map(alert => `\n      <div class=\"alert ${tierClass(alert.tier)}\">\n        <strong>${alert.title}</strong> &mdash; ${alert.tier_name}\n        ${alert.members.map(m => `<div class=\"member\">${m.drug_name} (${m.section || 'duplication'}): \"${m.sentence}\" &mdash; <a href=\"${m.dailymed_url}\" target=\"_blank\" rel=\"noopener\">DailyMed</a></div>`).join('')}\n      </div>`).join('');\n  } else {\n    html += `<p>${data.no_warning_text || 'No warning found in the labels checked.'}</p>`;\n  }\n  if (data.unresolved_entries && data.unresolved_entries.length) {\n    html += '<h3>Unresolved entries</h3>' + data.unresolved_entries.map(entry => `\n      <div class=\"unresolved\">\"${entry.raw_text}\" &mdash; ${entry.reason}${entry.candidates.length ? ' (candidates: ' + entry.candidates.join('; ') + ')' : ''}</div>`).join('');\n  }\n  results.innerHTML = html;\n}\n\ndocument.getElementById('search-button').addEventListener('click', runSearch);\ndocument.getElementById('check-button').addEventListener('click', runCheck);\nloadTerms();\n</script>\n</body>\n</html>\n"
  },
